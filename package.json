{
  "name": "dsh-allow",
  "version": "0.1.0",
  "description": "DeepSeek Harness 权限记忆插件：把某类命令加进允许列表，之后同类命令不再询问。 / Remember sandbox-escalation approvals so the same commands stop asking.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DWJZ/dsh-allow.git"
  },
  "homepage": "https://github.com/DWJZ/dsh-allow#readme",
  "keywords": [
    "deepseek",
    "harness",
    "dsh-plugin",
    "approval",
    "permissions"
  ],
  "main": "src/index.js",
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "test",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
